# ==============================================================================
# SRM Chatbots Frontend (Next.js App) - Environment Template
# Duplicate this file to '.env.local' for local development overrides
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL (Server-Side Proxy)
# ------------------------------------------------------------------------------
# Origin URL of the Django REST backend.
# The Next.js API proxy (src/app/api/backend/[...path]/route.ts) forwards requests here.
# Do NOT include trailing slashes or the '/api' prefix.
DJANGO_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. FRONTEND APPLICATION URL
# ------------------------------------------------------------------------------
# Origin URL of this Next.js web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. PUBLIC API ENDPOINTS
# ------------------------------------------------------------------------------
# Base path for browser-side requests routed through the Next.js proxy
NEXT_PUBLIC_API_URL=/api/backend

# Direct backend URL for public widgets or standalone client integrations
NEXT_PUBLIC_DJANGO_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Node runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# Gemini credentials belong in srm-chatbots-api/.env only.
